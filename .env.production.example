# ============================================================
# VEHO Edu — ambiente de PRODUÇÃO
# Copie para .env.production (ou cole no painel do host).
# NÃO commite este arquivo preenchido.
# ============================================================

NODE_ENV=production
PORT=3000

# MongoDB Atlas (recomendado) ou URI interna do compose
MONGODB_URI=mongodb+srv://USER:SENHA@CLUSTER.mongodb.net/veho_edu?retryWrites=true&w=majority

# Gere: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d

# URL pública HTTPS (sem barra no final)
FRONTEND_URL=https://SEUDOMINIO.com.br

# Assinatura — OBRIGATÓRIO em produção
ASSINATURA_MODO_DEV=false
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ESSENCIAL=price_...
STRIPE_PRICE_PROFISSIONAL=price_...
STRIPE_PRICE_COMPLETO=price_...

# Opcional
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@SEUDOMINIO.com.br
# OPENAI_API_KEY=
# ENCRYPTION_KEY=

# Seed em produção: NÃO rode seeds de demo com senha123.
# Se precisar seed controlado:
# ALLOW_SEED_IN_PRODUCTION=true
# SEED_DEFAULT_PASSWORD=SenhaForteMinimo12!
