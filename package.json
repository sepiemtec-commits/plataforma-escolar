{
  "name": "plataforma-escolar",
  "version": "1.0.0",
  "description": "VEHO — Plataforma de Gestão Educacional",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "lint": "eslint backend scripts database tests/api tests/unit tests/integration tests/security tests/helpers --max-warnings 80",
    "typecheck": "node scripts/typecheck.js",
    "migrate:check": "node scripts/migrate-check.js",
    "mongo:ativar": "node scripts/ativar-mongo.js",
    "healthcheck": "node scripts/ci-healthcheck.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:coverage": "jest --runInBand --selectProjects unit --coverage",
    "test:api": "jest --runInBand --selectProjects api",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:all": "jest --runInBand",
    "test:isolamento": "jest --runInBand --selectProjects api --testPathPattern=isolamentoTenant",
    "test:isolamento:legado": "node scripts/test-isolamento-escola.js",
    "test:e2e": "node scripts/teste-e2e-funcionalidade.js",
    "test:e2e:pw": "playwright test --config=tests/e2e/playwright.config.js",
    "test:e2e:pw:report": "playwright show-report tests/e2e/playwright-report",
    "test:e2e:server": "node tests/e2e/server/start-e2e-server.js",
    "test:security": "jest --runInBand --selectProjects api --testPathPattern='segurancaApp|authSeguranca' && jest --runInBand --selectProjects unit --testPathPattern='rolesAndInjection|safePath|sanitize|jwtSecret'",
    "test:k6:smoke": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/smoke.js",
    "test:k6:A": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/A-100.js",
    "test:k6:B": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/B-500.js",
    "test:k6:C": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/C-1000.js",
    "test:k6:D": "PATH=\"$PWD/tools/bin:$PATH\" k6 run -e ALLOW_HEAVY=1 tests/performance/k6/scenarios/D-5000.js",
    "test:k6:E": "PATH=\"$PWD/tools/bin:$PATH\" k6 run -e ALLOW_HEAVY=1 -e ALLOW_10K=1 tests/performance/k6/scenarios/E-10000.js",
    "test:k6:progressive": "PATH=\"$PWD/tools/bin:$PATH\" bash tests/performance/scripts/run-progressive.sh",
    "test:k6:capacity": "node tests/performance/scripts/check-capacity.js",
    "test:k6:target": "node tests/performance/scripts/start-load-target.js",
    "test:load": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/load.js",
    "test:stress": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/stress.js",
    "test:k6:spike:boletim": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/boletim-spike.js",
    "test:k6:spike:boletim:heavy": "PATH=\"$PWD/tools/bin:$PATH\" k6 run -e ALLOW_HEAVY=1 tests/performance/k6/scenarios/boletim-spike.js",
    "test:spike": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/boletim-spike.js",
    "test:k6:spike:analyze": "node tests/performance/scripts/analyze-spike-bottleneck.js",
    "test:endurance": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/endurance-E1-500-2h.js",
    "test:k6:endurance:E1": "PATH=\"$PWD/tools/bin:$PATH\" k6 run tests/performance/k6/scenarios/endurance-E1-500-2h.js",
    "test:k6:endurance:E2": "PATH=\"$PWD/tools/bin:$PATH\" env ALLOW_ENDURANCE_E2=1 k6 run tests/performance/k6/scenarios/endurance-E2-1000-4h.js",
    "test:quick": "npm run lint && npm run typecheck && npm run test:unit",
    "test:normal": "npm run test:quick && npm run test:api && npm run test:integration",
    "test:full": "npm run test:normal && npm run test:security && npm run migrate:check && npm run healthcheck && ASSINATURA_MODO_DEV=true DISABLE_RATE_LIMIT=1 npm run test:e2e:pw",
    "test:performance": "npm run test:k6:smoke",
    "test:performance:heavy": "echo 'Use staging: test:k6:A / spike / endurance — nunca no PR' && exit 1",
    "validar:golive": "node scripts/validar-go-live.js",
    "deploy:render": "node scripts/deploy-render.js",
    "seed": "node database/seeds.js",
    "seed:massa": "node database/seed-massa.js",
    "seed:presencas": "node database/seed-presencas.js",
    "seed:horarios": "node database/seed-horarios.js",
    "seed:rotacionar-senhas": "node database/rotacionar-senhas-fracas.js",
    "db:up": "docker-compose up -d",
    "db:scale:up": "docker-compose -f tests/database/docker-compose.pg-scale.yml up -d",
    "db:scale:down": "docker-compose -f tests/database/docker-compose.pg-scale.yml down -v",
    "test:db:scale": "node tests/database/scripts/run-token10.js",
    "test:db:scale:100k": "SCALE_ALUNOS=100000 node tests/database/scripts/run-token10.js",
    "test:db:scale:1m": "SCALE_ALUNOS=1000000 node tests/database/scripts/run-token10.js",
    "test:resilience": "node tests/recovery/scripts/run-token11.js",
    "test:resilience:target": "node tests/recovery/scripts/start-resilience-target.js",
    "db:dr:up": "docker-compose -f tests/dr/docker-compose.dr.yml up -d",
    "db:dr:down": "docker-compose -f tests/dr/docker-compose.dr.yml down -v",
    "test:dr": "node tests/dr/scripts/run-token12.js",
    "test:dr:backup-auto": "bash tests/dr/scripts/backup-auto.sh",
    "test:concurrency": "jest --runInBand --selectProjects api --testPathPattern=concorrencia",
    "test:preprod": "node tests/preprod/scripts/run-token15.js",
    "setup": "docker-compose up -d && sleep 3 && npm run seed"
  },
  "keywords": [
    "educação",
    "gestão escolar",
    "presença",
    "notas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "stripe": "^22.3.1",
    "twilio": "^6.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
