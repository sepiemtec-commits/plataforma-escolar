# .gitignore - Arquivos a ignorar no Git

# Dependências
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# Variáveis de ambiente
.env
.env.local
.env.*.local
.env.production
!.env.example
!.env.production.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store

# Build e dist
dist/
build/
*.min.js
*.min.css

# Logs
logs/
*.log

# Arquivos temporários
tmp/
temp/
*.tmp

# Banco de dados (local)
*.db
*.sqlite
data/

# Cache
.cache/
.eslintcache
.prettier-ignore

# Cobertura de testes
coverage/

# OS
Thumbs.db
.DS_Store
*.iml

# Arquivos enviados
uploads/
private/
private-key.pem
tools/bin/k6
tests/performance/results/load-users.json
tests/performance/results/*.json
tests/performance/results/*.txt
tests/performance/results/RELATORIO-*.md
!tests/performance/results/.gitkeep
!tests/performance/results/.gitignore

tests/performance/results/load-users-responsaveis.json
tests/dr/backups/
tests/dr/results/
tests/dr/fixtures/
tests/recovery/results/
tests/e2e/.auth/
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/results/
