# Copie para .env e preencha com seus dados
NODE_ENV=development
PORT=3000

# Banco de Dados
MONGODB_URI=mongodb://localhost:27017/plataforma_escolar
DB_HOST=localhost
DB_PORT=27017
DB_NAME=plataforma_escolar
# Pool Mongo — default driver=100 saturava no spike de boletim; use ≥200 em produção
MONGO_MAX_POOL=200
MONGO_MIN_POOL=10
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
# Logins bcrypt concorrentes (evita fila Mongo no dia da publicação)
LOGIN_CONCURRENCY=40
LOGIN_GATE_TIMEOUT_MS=8000

# JWT — obrigatório: mínimo 32 chars, aleatório (openssl rand -hex 32)
# O servidor NÃO inicia com placeholder ou fallback fraco.
JWT_SECRET=SUBSTITUA_por_openssl_rand_hex_32_minimo_32_caracteres_aleatorios
JWT_EXPIRE=7d
# Refresh opaco (dias) e máx. de sessões por usuário
JWT_REFRESH_DAYS=14
JWT_REFRESH_MAX=10
# Anti brute-force no login (falhas / 15 min). Em testes: DISABLE_RATE_LIMIT=1
RATE_LIMIT_LOGIN_MAX=5
# DISABLE_RATE_LIMIT=1

# Email/WhatsApp/SMS (opcional — Twilio)
# WhatsApp: from/to com prefixo whatsapp: (serviço interno).
# SMS: mesmo número TWILIO_PHONE_NUMBER sem prefixo (precisa estar habilitado para SMS).
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_NUMBER=+55xxxxxxxxxxx

# Web Push (opcional) — gere com: node scripts/gerar-vapid.js
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@escola.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@escola.local

# URL Frontend (em produção use a URL pública HTTPS — obrigatório para CORS)
FRONTEND_URL=http://localhost:3000

# Segurança
ENCRYPTION_KEY=sua_chave_de_encriptacao

# ---- Assinatura SaaS (Stripe) ----
# Em desenvolvimento sem chaves Stripe, ative o modo dev para cadastrar escolas sem cobrança:
ASSINATURA_MODO_DEV=true
# Produção: defina as chaves e Price IDs (um Product/Price por plano) e DESATIVE o modo dev:
# ASSINATURA_MODO_DEV=false
# STRIPE_SECRET_KEY=sk_live_...   # ou sk_test_... / rk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ESSENCIAL=price_...
# STRIPE_PRICE_PROFISSIONAL=price_...
# STRIPE_PRICE_COMPLETO=price_...
# Webhook endpoint: POST /api/assinatura/webhook
# Eventos: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted

# Senhas — NUNCA use senha123 em produção
# Desenvolvimento: se vazio, o seed usa senha123
# DEFAULT_USER_PASSWORD=senha123
# SEED_DEFAULT_PASSWORD=senha123
#
# Produção (seed só com estas flags):
# NODE_ENV=production
# ALLOW_SEED_IN_PRODUCTION=true
# SEED_DEFAULT_PASSWORD=SenhaForteMinimo12!
# Cadastro sem senha informada gera senha temporária aleatória.

# ---- IA Pedagógica (opcional) ----
# Sem chave, o painel do professor usa o motor local (regras + textos-modelo).
# Para usar OpenAI: crie a chave em https://platform.openai.com → API keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
